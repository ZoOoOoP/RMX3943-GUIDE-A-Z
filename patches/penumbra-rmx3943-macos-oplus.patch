diff --git a/core/src/da/xml/patch.rs b/core/src/da/xml/patch.rs
index 0459f9a..1184495 100644
--- a/core/src/da/xml/patch.rs
+++ b/core/src/da/xml/patch.rs
@@ -88,6 +88,51 @@ pub fn patch_boot_to(da: &mut [u8], analyzer: &Analyzer) -> Result<bool> {
 fn patch_security(da: &mut [u8], analyzer: &Analyzer) -> Result<bool> {
     patch_sec_policy(da, analyzer)?;
     patch_sbc(da, analyzer)?;
+    patch_oplus_security(da, analyzer)?;
+    Ok(true)
+}
+
+fn patch_oplus_security(da: &mut [u8], analyzer: &Analyzer) -> Result<bool> {
+    if !matches!(analyzer, Analyzer::Arm(_)) {
+        return Ok(false);
+    }
+
+    // Oplus wraps the generic DA policy with an additional vendor check.
+    // Returning success here lets the existing command-registration routine
+    // expose the normal read/boot commands after HeapBait reruns it.
+    if let Some(off) = analyzer.fn_from_str("cust_security_verify_sec_policy") {
+        patch(da, off, FORCE_RETURN_ARM)?;
+        info!("Patched Oplus security policy verification.");
+    }
+
+    // Older Oplus XML DAs gate command registration on a global permission
+    // byte. The function containing the diagnostic below loads its address
+    // with adjacent ARM MOVW/MOVT instructions 0x28 bytes before the xref.
+    if let Some(xref) = analyzer.str_xref("[oplus] do not get oplus permission\n") {
+        let insn_off = xref.saturating_sub(0x28);
+        if insn_off + 8 <= da.len() {
+            let movw = u32::from_le_bytes(da[insn_off..insn_off + 4].try_into().unwrap());
+            let movt = u32::from_le_bytes(da[insn_off + 4..insn_off + 8].try_into().unwrap());
+            let rd_w = (movw >> 12) & 0xF;
+            let rd_t = (movt >> 12) & 0xF;
+            let is_movw = movw & 0x0FF00000 == 0x03000000;
+            let is_movt = movt & 0x0FF00000 == 0x03400000;
+
+            if is_movw && is_movt && rd_w == rd_t {
+                let lo = ((movw >> 4) & 0xF000) | (movw & 0xFFF);
+                let hi = ((movt >> 4) & 0xF000) | (movt & 0xFFF);
+                let address = (hi << 16) | lo;
+                if let Some(base) = analyzer.off_to_va(0) {
+                    let flag_off = (address as u64).saturating_sub(base) as usize;
+                    if flag_off + 4 <= da.len() {
+                        patch(da, flag_off, &[0xFF, 0x00, 0x00, 0x00])?;
+                        info!("Patched Oplus command allowance flag.");
+                    }
+                }
+            }
+        }
+    }
+
     Ok(true)
 }
 
